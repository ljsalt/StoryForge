# =========================================================
# StoryForge 环境变量示例
# 使用方法：复制本文件为 .env 后按需修改。
# 注意：.env 不会提交到 Git，请放心存放敏感配置。
# 所有配置均有合理默认值，不配置也能正常运行。
# =========================================================

# ---- 后端配置（backend） ----
# 监听地址。0.0.0.0 表示允许局域网访问（仅限可信局域网，勿暴露公网）
HOST=0.0.0.0
# 后端端口
PORT=8000
# 允许跨域访问的前端来源（逗号分隔）。局域网来源已自动放行，一般无需修改
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据存储 ----
# SQLite 数据库文件（默认为项目 data 目录下）
DATABASE_PATH=data/storyforge.db
# API Key 加密主密钥文件（首次启动自动生成；禁止提交 Git，请与数据库一起备份）
SECRET_KEY_FILE=data/secrets/fernet.key

# ---- 模型接口 ----
# 调用第三方模型接口的超时（秒）
MODEL_REQUEST_TIMEOUT=20
# 是否允许模型 Base URL 指向本机/内网地址。
# 默认 false 以降低 SSRF 风险；仅在本机部署模型服务时才设为 true
ALLOW_PRIVATE_ENDPOINTS=false

# ---- 前端配置（frontend/.env，可选） ----
# 默认情况下前端会自动推导后端地址（与访问前端所用 IP 相同，端口 8000）。
# 仅当后端部署在别的机器时才需要设置：
# VITE_API_BASE_URL=http://192.168.1.100:8000
